{
    "name": "qq-official-bot",
    "version": "1.3.1",
    "description": "qq机器人开发SDK",
    "main": "lib/index.js",
    "engines": {
        "node": ">=20.12"
    },
    "scripts": {
        "start": "node .",
        "compile": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "dtsc": "dtsc --project tsconfig.dtsc.json",
        "clean": "rm -rf ./lib",
        "build": "npm run compile && npm run dtsc",
        "dev": "ts-node-dev -r tsconfig-paths/register ./src/test.ts",
        "pub": "npm publish --access public",
        "docs:dev": "vitepress dev docs --port 5566",
        "docs:build": "vitepress build docs",
        "docs:serve": "vitepress serve docs",
        "test": "TS_NODE_PROJECT=tsconfig.test.json node -r tsconfig-paths/register -r ts-node/register --test tests/*.test.ts"
    },
    "files": [
        "lib",
        "LICENSE",
        "README.md"
    ],
    "repository": {
        "url": "git+https://github.com/zhinjs/qq-official-bot.git",
        "type": "git"
    },
    "keywords": [
        "qq",
        "group",
        "bot"
    ],
    "author": "凉菜",
    "license": "MIT",
    "packageManager": "pnpm@9.0.2",
    "pnpm": {
        "overrides": {
            "esbuild": "^0.25.0",
            "vite": "^7.3.2"
        }
    },
    "dependencies": {
        "@noble/curves": "^1.6.0",
        "axios": "1.16.1",
        "formdata-node": "^6.0.3",
        "log4js": "^6.9.1",
        "ws": "^8.20.1"
    },
    "devDependencies": {
        "@types/node": "^20.11.5",
        "@types/ws": "^8.5.10",
        "dtsc": "^2.3.0",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "tsc-alias": "^1.8.8",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.2",
        "vitepress": "2.0.0-alpha.17"
    }
}
